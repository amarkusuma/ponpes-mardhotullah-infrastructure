# ── Image ─────────────────────────────────────────────
GHCR_OWNER=amarkusuma
IMAGE_TAG=latest

# ── Domain ────────────────────────────────────────────
# DNS A record: mardhotullah.com, www, cms, api → IP server
# HTTPS ditangani Traefik milik stack NuSewa (certresolver letsencrypt).
DOMAIN=mardhotullah.com

# ⚠ Semua nilai "ganti-*" WAJIB diganti sebelum deploy. Generate nilai acak:
#   openssl rand -hex 24   # POSTGRES_PASSWORD, MINIO_SECRET_KEY
#   openssl rand -hex 32   # JWT_SECRET (64 karakter)
#   openssl rand -hex 10   # MINIO_ACCESS_KEY

# ── Database ──────────────────────────────────────────
POSTGRES_USER=marhotullah
POSTGRES_PASSWORD=ganti-password-db
POSTGRES_DB=marhotullah_app

# ── Backend ───────────────────────────────────────────
JWT_SECRET=ganti-dengan-secret-minimal-32-karakter-acak
LOG_LEVEL=info
ACCESS_TOKEN_TTL=6h
REFRESH_TOKEN_TTL=168h

# ── MinIO ─────────────────────────────────────────────
MINIO_ACCESS_KEY=ganti-access-key
MINIO_SECRET_KEY=ganti-secret-key-minimal-8-karakter
MINIO_BUCKET=ponpes
